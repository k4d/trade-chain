---
/* Component UI <Table> */

/**
 * A reusable table component with headers and rows.
 *
 * @component
 * @example
 * <Table
 *   headers={["Name", "Price", "Volume", "Market Cap"]}
 *   rows={[
 *     ["Bitcoin", "$110925", "$62,044,348,039", "$2.2T"],
 *     ["Ethereum", "$2776", "$29,639,038,045", "$334.63B"],
 *     ["XRP", "$2.44", "$5,291,313,135", "$144.59B"]
 *   ]}
 * />
 *
 * @param {Object} props - Component props
 * @param {string[]} props.headers - List of header titles
 * @param {string[][]} props.rows - 2D array of table data
 * @param {string} [props.class] - Optional custom Tailwind classes for the table
 * @param {string} [props.emptyText='No data available.'] - Text shown when no rows are present
 * @param {boolean} [props.striped=false] - Adds alternating row background colors
 */

import { cx } from "@/utils/cx";

type TableCell = string | number;

interface Props {
	/**
	 * Array of column headers
	 */
	headers: string[];

	/**
	 * 2D array of table data
	 */
	rows: TableCell[][];

	/**
	 * Optional custom Tailwind classes
	 */
	class?: string;

	/**
	 * Optional text shown when rows array is empty
	 */
	emptyText?: string;

	/**
	 * Optional boolean to enable striped rows
	 */
	striped?: boolean;
}

const {
	headers,
	rows,
	emptyText = "No data available.",
	striped = false,
	class: className,
} = Astro.props;

/**
 * Base wrapper classes.
 */
const wrapperClasses = "overflow-x-auto";

/**
 * Base table classes.
 */
const baseClasses = "min-w-full divide-y divide-gray-200";

/**
 * Combined table classes.
 */
const combinedClasses = cx(baseClasses, className);
---

<div class={wrapperClasses}>
	<table class={combinedClasses}>
		<thead>
			<tr>
				{
					headers.map((header: string) => (
						<th
							scope="col"
							class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider"
						>
							{header}
						</th>
					))
				}
			</tr>
		</thead>

		<tbody class="bg-white divide-y divide-gray-200">
			{
				rows.length > 0 ? (
					rows.map((row, rowIndex) => {
						const isStriped = striped && rowIndex % 2 === 1;
						return (
							<tr
								data-row-index={rowIndex}
								class={isStriped ? "bg-gray-50" : ""}
							>
								{row.map((cell, cellIndex) => (
									<td
										data-cell-index={cellIndex}
										class="px-6 py-4 whitespace-nowrap text-sm"
									>
										{typeof cell === "number"
											? cell.toLocaleString()
											: cell}
									</td>
								))}
							</tr>
						);
					})
				) : (
					<tr>
						<td
							colspan={headers.length}
							class="py-4 px-6 text-center text-gray-500"
						>
							{emptyText}
						</td>
					</tr>
				)
			}
		</tbody>
	</table>
</div>
